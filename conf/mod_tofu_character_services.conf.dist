[worldserver]

########################################
# mod-tofu-character-services
########################################
#
# Archivist Ellery Ashby <Character Services> (creature 900042, place with .npc add 900042): arrange the account's
# characters, change name, change race, change faction, and leave combat, plus menus for the player commands of
# mod-autonomous-altbots (.autoalt), mod-aoe-loot (.aoeloot), and mod-individual-xp (.xp), each with its own key
# below. Bots never get these services.
#
#    TofuCharServices.Enable
#        Description: Turn the module on. While off, the NPC only says goodbye and .charorder is refused.
#        Default:     0 - Off
#                     1 - On

TofuCharServices.Enable = 0

#    TofuCharServices.OrderCommand
#        Description: Also allow the player command .charorder, which opens the character order menu anywhere.
#                     While on, ".char" stops working as an abbreviation of ".character" (it matches both commands);
#                     type ".chara" or the full name.
#        Default:     1 - On
#                     0 - Off (only the NPC)

TofuCharServices.OrderCommand = 1

#    TofuCharServices.RenameCost
#    TofuCharServices.RaceChangeCost
#    TofuCharServices.FactionChangeCost
#        Description: Price in copper (10000 = 1 gold), taken when the change is bought and refunded in full if the
#                     player cancels it before logging out. 0 is free.
#        Default:     0

TofuCharServices.RenameCost = 0
TofuCharServices.RaceChangeCost = 0
TofuCharServices.FactionChangeCost = 0

#    TofuCharServices.LeaveCombat.Enable
#        Description: Offer "Leave combat" while the player is in combat. Refused inside instances (dungeons, raids,
#                     battlegrounds, arenas) and while a living attacker is within LeaveCombat.Range yards.
#        Default:     1 - On
#                     0 - Off

TofuCharServices.LeaveCombat.Enable = 1

#    TofuCharServices.LeaveCombat.Range
#        Description: Yards. A living unit attacking the player this close blocks "Leave combat".
#        Default:     50

TofuCharServices.LeaveCombat.Range = 50

#    TofuCharServices.AutoAlt.Enable
#        Description: Show "Autonomous alts": the account's other characters marked on or off, each with Turn on,
#                     Turn off, and Show status, which run .autoalt start, stop, and status for that character.
#                     Needs mod-autonomous-altbots in the build (the menu reads its character_settings rows).
#        Default:     0 - Off
#                     1 - On

TofuCharServices.AutoAlt.Enable = 0

#    TofuCharServices.AutoAlt.Parties
#        Description: Also show "Alt parties": create, join, add, remove, disband, and list (.autoalt party ...).
#                     Needs AutoAlt.Enable = 1, and AutonomousAltBots.Party.Enable = 1 in mod_autonomous_altbots.conf
#                     (the menu reads tofu_autoalt_party and tofu_autoalt_party_member).
#        Default:     0 - Off
#                     1 - On

TofuCharServices.AutoAlt.Parties = 0

#    TofuCharServices.AoeLoot.Enable
#        Description: Show "Turn AoE loot on" and "Turn AoE loot off" (.aoeloot on, .aoeloot off; mod-aoe-loot).
#        Default:     0 - Off
#                     1 - On

TofuCharServices.AoeLoot.Enable = 0

#    TofuCharServices.Xp.Enable
#        Description: Show "My XP rate": view, presets, a custom rate, default, enable, and disable (.xp ...;
#                     mod-individual-xp). That module still applies IndividualXp.MaxXPRate and its challenge locks.
#        Default:     0 - Off
#                     1 - On

TofuCharServices.Xp.Enable = 0

#    TofuCharServices.Xp.Presets
#        Description: XP rates offered as one-click options, whole numbers separated by spaces (at most 10).
#        Default:     "1 2 3 5 10 20"

TofuCharServices.Xp.Presets = "1 2 3 5 10 20"

#    TofuCharServices.RealmFirst.Enable
#        Description: Show "Realm First achievements: on/off for this character", which runs .realmfirst optout on or
#                     off for the current character (Tofu fork of mod-realm-first-titles). That module must also have
#                     RealmFirstTitles.AllowPlayerOptOut = 1, or the command answers that opting out is turned off.
#        Default:     0 - Off
#                     1 - On

TofuCharServices.RealmFirst.Enable = 0
